# Copy to app/.env and adjust. app/.env is never served (it lives outside public/).
APP_ENV=production
APP_DEBUG=false
# Public site URL, used for canonical links, Open Graph tags, the sitemap and links in notification emails
APP_URL=https://www.eventzproconsult.com
# Leave empty to auto-detect. Set when serving from a sub-folder, e.g. /Eventzpro-Website
APP_BASE_PATH=

# Database for enquiries and admin users. Tables are created automatically on first use.
# sqlite: no setup, stored in app/storage/database/eventzpro.sqlite
# mysql:  create a database + user in hPanel (Databases > MySQL) and fill in the values below
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Contact form notifications go to MAIL_TO
MAIL_ENABLED=true
MAIL_TO=info@eventzproconsult.com
MAIL_FROM=no-reply@eventzproconsult.com
MAIL_FROM_NAME="Eventzpro Website"
# mail = PHP mail(); smtp = send through a mailbox (recommended: better delivery, fewer spam-folder issues)
MAIL_TRANSPORT=mail
# Hostinger email: smtp.hostinger.com, port 465 + ssl (or 587 + tls). MAIL_FROM should be this mailbox.
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=

# Admin panel (/admin). Set a long random value, open /admin/setup once to create the first
# administrator, then remove it. Alternatively run: php scripts/create-admin.php
ADMIN_SETUP_TOKEN=

# true only behind a trusted proxy/CDN that sets X-Forwarded-For
TRUST_PROXY=false

# Preview hosting only: send X-Robots-Tag noindex on every response
APP_NOINDEX=false
