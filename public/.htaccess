# Eventzpro Consult — web root rules (Apache / LiteSpeed on Hostinger)

Options -Indexes -MultiViews
ServerSignature Off
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS in production (skipped on localhost and for the /robots.txt health check)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteCond %{REQUEST_URI} !^/robots\.txt$
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block dotfiles (except .well-known) and backup/source files
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteRule \.(bak|old|orig|sql|log|ini|sh|env|md|lock|json\.dist)$ - [F,NC,L]

    # Front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# Only index.php may execute PHP in the web root
<FilesMatch "\.(php|phtml|phar)$">
    Require all denied
</FilesMatch>
<Files "index.php">
    Require all granted
</Files>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    <FilesMatch "\.(css|js|webp|png|jpg|jpeg|svg|woff2|pdf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

AddType image/webp .webp
AddType image/svg+xml .svg
