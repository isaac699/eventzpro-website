# Project root (used when the whole folder sits inside a web root, e.g. XAMPP htdocs).
# Everything is routed into /public; app code, storage, source images and docs are never served.

Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|images|vendor)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
